<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The single Metamorphosis add-in project.

    This used to be two projects holding byte-identical copies of 34 source files -
    RevitFingerPrint for .NET Framework and MetamorphosisCore for .NET 8 - because Revit
    2025 moved the add-in runtime. Keeping them in step meant copying every change across
    by hand, and they had already drifted. One project targeting whichever framework the
    chosen Revit release needs removes that whole class of mistake.

    Target framework, defines and Revit API package version all come from $(RevitVersion),
    set in ../Directory.Build.props. Build a specific release with:

        dotnet build src/MetamorphosisCore/MetamorphosisCore.csproj -p:RevitVersion=2024
  -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>Metamorphosis</AssemblyName>
    <RootNamespace>Metamorphosis</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- WinForms for the dialogs, WPF because the ribbon buttons want ImageSource. -->
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <AssemblyTitle>Metamorphosis</AssemblyTitle>
    <Company>Team Metamorphosis / AEC Hackathon 2016</Company>
    <Product>Metamorphosis</Product>
    <Copyright>MNM, KM, CP, TH Copyright ©  2016-2026</Copyright>
    <AssemblyVersion>3.2.0.0</AssemblyVersion>
    <FileVersion>3.2.0.0</FileVersion>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <!--
    Revit API assemblies come from NuGet rather than from an install path. The old
    projects pointed at C:\Program Files\Autodesk\Revit 20XX\RevitAPI.dll, so the build
    only worked on a machine with that exact release installed - no CI, and no building
    for a Revit you do not have. These packages are reference-only: Revit loads its own
    copies at run time, so they must not be copied to the output.
  -->
  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiPackageVersion)">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiPackageVersion)">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.118" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- .NET Framework needs these as framework references. UseWindowsForms/UseWPF only
       pull them in automatically on net8.0-windows and later, so on net48 the WPF
       assemblies behind System.Windows.Media have to be named explicitly. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Configuration" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <!-- Read back by DataUtility and ExternalApp through GetManifestResourceStream, so the
       ids must keep matching the assembly name - see Utilities/ResourceNames.cs. -->
  <ItemGroup>
    <EmbeddedResource Include="databaseFormat.txt" />
    <EmbeddedResource Include="DBScript\UpgradeToV1.txt" />
    <EmbeddedResource Include="DBScript\UpgradeToV1.1.txt" />
    <EmbeddedResource Include="DBScript\UpgradeToV1.2.txt" />
    <EmbeddedResource Include="Images\*.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Settings.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
